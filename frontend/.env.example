# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (main: storage uploads, trends/photo caches) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# --- Charts Supabase (artist index for Chart Reels + the `index` carousel) ---
# A SEPARATE project (the indextrading/sonotrade app) that keeps the
# artists_with_history view up to date. Publishable/anon-grade key — it ships in
# the client bundle, so it must be a read-only key on an RLS-protected project.
# NEXT_PUBLIC_* is inlined at BUILD time: changing it needs a rebuild to take effect.
NEXT_PUBLIC_CHARTS_SUPABASE_URL=https://your-charts-project.supabase.co
NEXT_PUBLIC_CHARTS_SUPABASE_KEY=your-charts-publishable-key

# --- AI services ---
GEMINI_API_KEY=...
NEWSDATA_API_KEY=...
SERPAPI_KEY=...
TWITTERAPI_IO_KEY=...
BRIA_API_TOKEN=...   # BRIA image expansion (Posts → Expand image); server-only, never NEXT_PUBLIC_

# --- Google OAuth (for Sheets import) ---
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
